# Public browser configuration. Never place service-role credentials here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only request database connection. Must use the NOBYPASSRLS request principal.
REQUEST_DATABASE_URL=

# Worker-only credentials belong in the worker environment and never in apps/web.
WORKER_DATABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
