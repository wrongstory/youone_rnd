# Worker-only environment. Never expose these values to apps/web.
WORKER_DATABASE_URL=
WORKER_DATABASE_TLS_MODE=verify-full
WORKER_DATABASE_POOL_MAX=5
WORKER_DATABASE_CONNECTION_TIMEOUT_MS=5000
WORKER_DATABASE_IDLE_TIMEOUT_MS=30000
WORKER_DATABASE_IDLE_IN_TRANSACTION_TIMEOUT_MS=15000
WORKER_DATABASE_QUERY_TIMEOUT_MS=15000
WORKER_DATABASE_STATEMENT_TIMEOUT_MS=10000
WORKER_READINESS_TIMEOUT_MS=5000
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PRIVATE_BUCKETS=documents-private,technical-private

# R05 Staging evidence runner. It refuses non-staging and Preview configurations.
DEPLOYMENT_STAGE=staging
STAGING_WEB_BASE_URL=https://staging.example.invalid
STAGING_ENVIRONMENT_ID=youone-staging
STAGING_COMMIT_SHA=
STAGING_CORRELATION_ID=
STAGING_READINESS_TIMEOUT_MS=10000

# R06 Release Gate. Paths point to a restricted CI workspace; do not commit inputs or artifacts.
R06_RELEASE_INPUT_PATH=
R06_ARTIFACT_ROOT=
R06_PROMOTION_SOURCE_COMMIT=
