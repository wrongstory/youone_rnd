# Browser-visible authentication configuration. URL must identify the same project as SUPABASE_URL below.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only request connection. The principal must be NOBYPASSRLS.
REQUEST_DATABASE_URL=
REQUEST_DATABASE_TLS_MODE=verify-full
REQUEST_DATABASE_POOL_MAX=10
REQUEST_DATABASE_CONNECTION_TIMEOUT_MS=5000
REQUEST_DATABASE_IDLE_TIMEOUT_MS=30000
REQUEST_DATABASE_IDLE_IN_TRANSACTION_TIMEOUT_MS=15000
REQUEST_DATABASE_QUERY_TIMEOUT_MS=15000
REQUEST_DATABASE_STATEMENT_TIMEOUT_MS=10000

# Server request Auth uses the same Supabase project as the browser and a public/publishable key only.
# Never place a service-role key here.
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
REQUEST_AUTH_TIMEOUT_MS=5000
IDENTITY_RESOLVER_DATABASE_URL=postgresql://youone_identity_resolver_login:replace_me@db.example:5432/app
IDENTITY_RESOLVER_DATABASE_TLS_MODE=verify-full

# Explicit screen-review mode. Never enable this for a real operating environment.
YOUONE_PREVIEW_DATA=
