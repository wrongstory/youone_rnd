# Browser-visible authentication configuration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only request connection. The principal must be NOBYPASSRLS.
REQUEST_DATABASE_URL=
REQUEST_DATABASE_TLS_MODE=verify-full
REQUEST_DATABASE_POOL_MAX=10
REQUEST_DATABASE_CONNECTION_TIMEOUT_MS=5000
REQUEST_DATABASE_IDLE_TIMEOUT_MS=30000
REQUEST_DATABASE_IDLE_IN_TRANSACTION_TIMEOUT_MS=15000
REQUEST_DATABASE_QUERY_TIMEOUT_MS=15000
REQUEST_DATABASE_STATEMENT_TIMEOUT_MS=10000

# Explicit screen-review mode. Never enable this for a real operating environment.
YOUONE_PREVIEW_DATA=
